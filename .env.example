# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# "anon" / "publishable" key (es pública, no pasa nada si se ve)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" / "secret" key — ¡SECRETA! nunca la compartas
SUPABASE_SERVICE_ROLE_KEY=

# ── Panel de administración ───────────────────────────────────────
# Contraseña para entrar a /admin (usa una larga)
ADMIN_PASSWORD=

# ── Notificaciones de ofertas por Telegram (opcional, recomendado) ─
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Personalización (opcional) ────────────────────────────────────
NEXT_PUBLIC_STORE_NAME=El Casillero del Diablo
NEXT_PUBLIC_STORE_TAGLINE=Cosas que ya no uso, a buen precio 😈
# Tu usuario de Instagram sin @ (aparece en la cabecera)
NEXT_PUBLIC_INSTAGRAM=
# Código de moneda ISO y formato regional
NEXT_PUBLIC_CURRENCY=CLP
NEXT_PUBLIC_LOCALE=es-CL
# URL pública del sitio (para links en las notificaciones)
NEXT_PUBLIC_SITE_URL=
